<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/coverGreen"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgNavHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_home"
            app:tint="@color/white"
            android:padding="2dp"
            android:contentDescription="@string/tabHome" />

        <TextView
            android:id="@+id/txtNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tabHome"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navLedger"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgNavLedger"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_ledger"
            app:tint="@color/white"
            android:padding="2dp"
            android:contentDescription="@string/tabLedger" />

        <TextView
            android:id="@+id/txtNavLedger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tabLedger"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navStock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgNavStock"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_stock"
            app:tint="@color/white"
            android:padding="2dp"
            android:contentDescription="@string/tabStock" />

        <TextView
            android:id="@+id/txtNavStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tabStock"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPersonal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgNavPersonal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_personal"
            app:tint="@color/white"
            android:padding="2dp"
            android:contentDescription="@string/tabPersonal" />

        <TextView
            android:id="@+id/txtNavPersonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tabPersonal"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgNavProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/white"
            android:padding="2dp"
            android:contentDescription="@string/tabProfile" />

        <TextView
            android:id="@+id/txtNavProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tabProfile"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>

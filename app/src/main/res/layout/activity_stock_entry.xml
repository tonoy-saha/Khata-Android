<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coverGreen"
    android:orientation="vertical"
    tools:context=".StockEntryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/backLink"
            android:textColor="@color/goldLeaf"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/stockViewTitle"
            android:textColor="@color/paper"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/paper"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            style="@style/Khata.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/lblDate" />
        <EditText
            android:id="@+id/etDate"
            style="@style/Khata.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="none" />
        <TextView
            style="@style/Khata.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblStockCommodity" />
        <AutoCompleteTextView
            android:id="@+id/actCommodity"
            style="@style/Khata.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/commodityPlaceholder"
            android:completionThreshold="1"
            android:inputType="textCapWords" />
        <TextView
            style="@style/Khata.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblStockBuy" />
        <EditText
            android:id="@+id/etBuy"
            style="@style/Khata.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="0.00"
            android:inputType="numberDecimal" />
        <TextView
            style="@style/Khata.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblStockSell" />
        <EditText
            android:id="@+id/etSell"
            style="@style/Khata.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="0.00"
            android:inputType="numberDecimal" />
        <TextView
            style="@style/Khata.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblStockQty" />
        <EditText
            android:id="@+id/etQty"
            style="@style/Khata.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="0.00"
            android:inputType="numberDecimal" />
        <TextView
            style="@style/Khata.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lblNote" />
        <EditText
            android:id="@+id/etNote"
            style="@style/Khata.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/notePlaceholder"
            android:inputType="text" />
        <Button
            android:id="@+id/btnSave"
            style="@style/Khata.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/addStockBtn" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
